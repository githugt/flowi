{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/githugt/flowi-lib/schema/environment.schema.json",
  "title": "Flow-I environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "colour": {
      "enum": [
        "red",
        "orange",
        "yellow",
        "lime",
        "green",
        "aqua",
        "blue",
        "purple",
        "gray"
      ]
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "secret"
            ],
            "properties": {
              "secret": {
                "const": true
              }
            }
          }
        ]
      }
    }
  }
}
