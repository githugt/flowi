{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/githugt/flowi-lib/schema/common.schema.json",
  "title": "Flow-I shared definitions",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A ULID in canonical upper-case form."
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "collection": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "description": "A ULID in canonical upper-case form."
        },
        "path": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "description": "A flow node. Keys not listed here are node-specific options.",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "request",
            "fetch",
            "webhook",
            "subflow",
            "extract",
            "set",
            "generate",
            "transform",
            "calc",
            "assert",
            "condition",
            "delay",
            "batch",
            "run_till",
            "parallel",
            "log",
            "note",
            "digest",
            "save",
            "stop"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "string"
        },
        "concurrent": {
          "type": "boolean"
        },
        "on_error": {
          "type": "string",
          "pattern": "^(fail|continue|goto:.+)$"
        },
        "timeout": {
          "type": "string"
        },
        "attach": {
          "type": "string",
          "description": "The id of a request or subflow node right next to this one that the canvas draws it with; a view only."
        },
        "attach_at": {
          "enum": [
            "above",
            "below"
          ],
          "description": "With attach: draw this node in a stack above or below that request, not beside it."
        },
        "request": {
          "$ref": "#/$defs/ref"
        },
        "version": {
          "type": "string"
        },
        "hooks": {
          "oneOf": [
            {
              "enum": [
                "all",
                "none"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "all",
                    "none"
                  ]
                },
                "skip": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "pre",
                      "post"
                    ]
                  }
                }
              }
            }
          ]
        },
        "with": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "flow": {
          "$ref": "#/$defs/ref"
        },
        "body": {
          "$ref": "#/$defs/nodes"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "nodes": {
                "$ref": "#/$defs/nodes"
              }
            }
          }
        },
        "then": {
          "$ref": "#/$defs/nodes"
        },
        "else": {
          "$ref": "#/$defs/nodes"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "when": {
                "type": "string"
              },
              "nodes": {
                "$ref": "#/$defs/nodes"
              }
            }
          }
        },
        "target": {
          "type": "string",
          "description": "set: vars.<name>, request.<field> or cookies.<name>"
        },
        "value": {
          "description": "set / log: the value or message (a template when text)"
        },
        "check": {
          "type": "string",
          "description": "assert: a boolean expression"
        },
        "on_fail": {
          "enum": [
            "error",
            "warn"
          ],
          "description": "assert: error fails the node; warn reports and continues"
        },
        "message": {
          "type": "string",
          "description": "assert: shown when the check fails; stop: why the run stops"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "description": "stop: how the run ends; passed (the default) is a normal end that skips the rest"
        },
        "from": {
          "enum": [
            "body",
            "header",
            "cookie",
            "status"
          ],
          "description": "extract (single form): where the value comes from"
        },
        "path": {
          "type": "string",
          "description": "extract: RFC 9535 JSONPath into the body"
        },
        "header": {
          "type": "string"
        },
        "cookie": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "set"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "target",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "check"
            ],
            "properties": {
              "on_fail": {
                "enum": [
                  "error",
                  "warn"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stop"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "log"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "extract"
              }
            },
            "required": [
              "type",
              "from"
            ]
          },
          "then": {
            "required": [
              "name",
              "from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "extract"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "from": {
                "enum": [
                  "body",
                  "header",
                  "cookie",
                  "status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "transform"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "delay"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "duration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run_till"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "until",
              "body"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "batch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "body"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "branches"
            ],
            "properties": {
              "wait": {
                "enum": [
                  "all",
                  "any",
                  "first-success"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fetch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "webhook"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "save"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "overwrite",
                  "latest-by-status",
                  "append"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "digest"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "sink": {
                "enum": [
                  "stdout",
                  "file",
                  "webhook"
                ]
              },
              "format": {
                "enum": [
                  "markdown",
                  "text",
                  "json"
                ]
              },
              "style": {
                "enum": [
                  "text",
                  "slack",
                  "discord",
                  "teams",
                  "email"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "request"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "request"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "flow"
            ]
          }
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "hookStep": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "flow": {
          "$ref": "#/$defs/ref"
        },
        "inline": {
          "$ref": "#/$defs/nodes"
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pre": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hookStep"
          }
        },
        "post": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hookStep"
          }
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "settings": {
      "$ref": "settings.schema.json"
    }
  }
}
