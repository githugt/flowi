{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/githugt/flowi-lib/schema/workspace.schema.json",
  "title": "Flowi workspace (workspace.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ulid"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "flow",
          "cron"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
          },
          "flow": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "env": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "tz": {
            "type": "string"
          },
          "disabled": {
            "type": "boolean"
          }
        }
      }
    },
    "settings": {
      "$ref": "common.schema.json#/$defs/settings"
    }
  }
}
