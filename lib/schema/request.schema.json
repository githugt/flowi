{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/githugt/flowi/lib/schema/request.schema.json",
  "title": "Flowi request (*.req.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "versions"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "description": "The OpenAPI operationId the request was imported from; Arazzo steps refer to requests by it."
    },
    "default": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/version"
      }
    },
    "edit": {
      "$ref": "#/$defs/version",
      "description": "Deprecated: earlier releases kept the dirty edit (the autosaved working copy) here, where a commit carried it. It is now kept in the workspace data directory; a file that still has one is read, the edit is moved there, and the next write of the file leaves it out. Never read by runs, serve or the CLI."
    },
    "edit_base": {
      "type": "string",
      "description": "Label of the version the edit started from."
    },
    "hooks": {
      "$ref": "common.schema.json#/$defs/hooks"
    },
    "tags": {
      "type": "array",
      "description": "Labels for `flowi run --tag`. A folder's tags apply to everything under it.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/statusName",
      "description": "The request's development status. Without one, the nearest folder above it that has a status applies."
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "query": {
          "$ref": "common.schema.json#/$defs/stringMap"
        },
        "headers": {
          "$ref": "common.schema.json#/$defs/stringMap"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "auth": {
          "$ref": "common.schema.json#/$defs/auth"
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "enum": [
                  "body",
                  "header",
                  "cookie",
                  "status"
                ]
              },
              "path": {
                "type": "string"
              },
              "header": {
                "type": "string"
              },
              "cookie": {
                "type": "string"
              },
              "regex": {
                "type": "string"
              }
            }
          }
        },
        "variables": {
          "$ref": "common.schema.json#/$defs/stringMap"
        },
        "name": {
          "type": "string",
          "description": "A short title for this version, shown beside its label."
        },
        "docs": {
          "type": "string",
          "description": "Documentation of this version, in Markdown."
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Descriptions of query parameters, headers and variables, by name.",
          "properties": {
            "query": {
              "$ref": "common.schema.json#/$defs/stringMap"
            },
            "headers": {
              "$ref": "common.schema.json#/$defs/stringMap"
            },
            "variables": {
              "$ref": "common.schema.json#/$defs/stringMap"
            }
          }
        },
        "disabled": {
          "type": "object",
          "additionalProperties": false,
          "description": "Names of the query parameters and headers kept in the file but not sent.",
          "properties": {
            "query": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assert": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expect": {
          "type": ["string", "integer"],
          "description": "The HTTP status the request is meant to answer with: 401, 400-499, 4xx or a list such as \"200, 404\". The default 'fail unless 2xx' hook stands aside when this is set."
        },
        "settings": {
          "$ref": "common.schema.json#/$defs/settings"
        },
        "hooks": {
          "$ref": "common.schema.json#/$defs/hooks"
        },
        "outcomes": {
          "type": "array",
          "description": "Named results a run can end in, each with a condition.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "disabled": {
                "type": "boolean"
              },
              "color": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "async": {
          "type": "object",
          "additionalProperties": false,
          "description": "A message sent to, or received from, a broker channel instead of an HTTP call.",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "server": {
              "type": "string"
            },
            "channel": {
              "type": "string"
            },
            "binding": {
              "$ref": "common.schema.json#/$defs/stringMap"
            },
            "send": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "body": {
                  "$ref": "#/$defs/body"
                },
                "headers": {
                  "$ref": "common.schema.json#/$defs/stringMap"
                }
              }
            },
            "receive": {
              "$ref": "#/$defs/receive"
            }
          }
        },
        "grpc": {
          "type": "object",
          "additionalProperties": false,
          "description": "A gRPC call instead of an HTTP one.",
          "properties": {
            "server": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "body": {
              "$ref": "#/$defs/body"
            },
            "proto": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "import": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "web": {
              "type": "boolean"
            },
            "receive": {
              "$ref": "#/$defs/receive"
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "description": "A SQL query against a database instead of an HTTP call.",
          "properties": {
            "driver": {
              "enum": [
                "postgres",
                "mysql",
                "mariadb",
                "sqlite"
              ]
            },
            "server": {
              "type": "string",
              "description": "A connection URL, or for sqlite the path of the file. Templated."
            },
            "query": {
              "type": "string",
              "description": "One statement. Not templated: values go in params."
            },
            "params": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            },
            "writes": {
              "type": "boolean",
              "description": "Let this query change data. Off by default."
            }
          }
        },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "description": "A SQL query over data files (CSV, Excel, Parquet) instead of an HTTP call. Read-only unless writes is on.",
          "properties": {
            "format": {
              "enum": [
                "csv",
                "xlsx",
                "parquet"
              ]
            },
            "path": {
              "type": "string",
              "description": "A file or a folder, relative to the collection. Templated."
            },
            "query": {
              "type": "string",
              "description": "One statement. Not templated: values go in params."
            },
            "params": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            },
            "writes": {
              "type": "boolean",
              "description": "Let this query change the data: the changed tables are written back to the file. Off by default."
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 1,
      "properties": {
        "json": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "form": {
          "$ref": "common.schema.json#/$defs/stringMap"
        },
        "multipart": {
          "type": [
            "object",
            "array"
          ],
          "description": "Parts by name; a list of one-entry mappings when a name repeats."
        }
      }
    },
    "receive": {
      "type": "object",
      "additionalProperties": false,
      "description": "What to wait for after sending.",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "string",
          "description": "A duration, such as 5s."
        },
        "match": {
          "type": "string",
          "description": "An expression a message must satisfy to count."
        }
      }
    }
  }
}
