--- request Ping
name: Ping
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/ping"
    query:
      verbose: "1"
      page: "2"
    headers:
      X-Team: blue
      Accept: application/json
      X-Api-Key: "{{secret.x_api_key}}"
      Authorization: Bearer {{secret.token}}
--- request Orders/Create-order
name: Create order
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/orders"
    headers:
      X-Team: blue
      Authorization: Basic {{toBase64("ada" + ":" + secret.password)}}
    body:
      json: "{\"password\":\"(redacted)\",\"sku\":\"abc\"}"
--- request Orders/Form
name: Form
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/forms"
    headers:
      X-Team: blue
    body:
      form:
        a: "1"
        secret: "{{secret.secret}}"
--- request Orders/Upload
name: Upload
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/up"
    headers:
      X-Team: blue
      X-Key: "{{secret.key}}"
    body:
      multipart:
        note: hi
--- request Orders/Token
name: Token
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/token"
    headers:
      X-Team: blue
      Content-Type: text/xml
    auth:
      type: oauth2
      grant: client_credentials
      token_url: "{{env.base_url}}/oauth/token"
      client_id: abc
      client_secret: "{{secret.client_secret}}"
      scope: read
    body:
      text: <a/>
--- request Orders/Implicit
name: Implicit
versions:
