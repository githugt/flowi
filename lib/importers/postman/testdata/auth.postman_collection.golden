--- request Digest
name: Digest
versions:
  "1":
    method: GET
    url: https://example.com/d
    auth:
      type: digest
      username: ada
      password: "{{secret.password}}"
--- request Token
name: Token
versions:
  "1":
    method: POST
    url: https://example.com/t
    auth:
      type: oauth2
      grant: client_credentials
      token_url: "{{env.base}}/oauth/token"
      client_id: abc
      client_secret: "{{secret.client_secret}}"
      scope: read
      client_auth: body
--- request Browser
name: Browser
versions:
  "1":
    method: GET
    url: https://example.com/b
    auth:
      type: oauth2
      grant: authorization_code
      authorization_url: "{{env.base}}/oauth/authorize"
      token_url: "{{env.base}}/oauth/token"
      client_id: abc
      scope: read
      pkce: "on"
--- request Aws
name: Aws
versions:
  "1":
    method: GET
    url: https://example.com/a
    auth:
      type: aws_sigv4
      access_key_id: AKIAEXAMPLE
      secret_access_key: "{{secret.aws_secret}}"
      region: eu-west-1
      service: execute-api
--- request Hawk
name: Hawk
versions:
  "1":
    method: GET
    url: https://example.com/h
    auth:
      type: hawk
      id: id1
      key: "{{secret.key}}"
      algorithm: sha256
--- request Oauth1
name: Oauth1
versions:
  "1":
    method: GET
    url: https://example.com/o
    auth:
      type: oauth1
      consumer_key: ck
      consumer_secret: "{{secret.consumer_secret}}"
      signature_method: HMAC-SHA1
