--- request Auth/Login
name: Login
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/v1/login"
    headers:
      Content-Type: application/json
    body:
      json: |-
        {
          "email": "{{env.email}}",
          "password": "{{secret.password}}",
          "nonce": "{{$uuid-v4}}"
        }
--- request Users/Get-user
name: Get user
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/v1/users/42"
    query:
      include: roles
    headers:
      Accept: application/json
      Authorization: Bearer {{secret.token}}
--- request Users/Get-user-orders
name: Get user orders
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/v1/users/{{user_id}}/orders"
    headers:
      Authorization: Bearer {{secret.token}}
--- request Users/Create-user
name: Create user
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/v1/users"
    headers:
      X-Api-Key: "{{secret.x_api_key}}"
      Authorization: Bearer {{secret.token}}
    body:
      multipart:
        name: "{{$full-name}}"
        email: "{{$email}}"
        iban: "{{env.randomBankAccountIban}}"
        avatar:
          file: /Users/ada/avatar.png
--- request Users/Search-users
name: Search users
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/v1/users/search"
    headers:
      Authorization: Basic {{toBase64("admin" + ":" + secret.password)}}
    body:
      form:
        q: ada
--- request Graph
name: Graph
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/graphql"
    query:
      api_key: "{{secret.api_secret}}"
    headers:
      Content-Type: application/json
    body:
      json: "{\"query\":\"query { me { id } }\",\"variables\":{\"a\":1}}"
--- request Partner
name: Partner
versions:
  "1":
    method: GET
    url: https://partner.example.com/v2/stock
    query:
      sku: "{{env.sku}}"
--- environment shop-api
name: shop-api
vars:
  base_url: https://api.example.com
  api_secret:
    secret: true
--- example Auth/Login OK
{
  "version": "1",
  "status": 200,
  "headers": [
    {
      "name": "Content-Type",
      "value": "application/json"
    }
  ],
  "body": {
    "expires_in": 3600,
    "token": "(redacted)"
  }
}
