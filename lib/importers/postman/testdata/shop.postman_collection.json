{
  "info": {
    "_postman_id": "6b1f0f8e-0000-4000-8000-000000000001",
    "name": "Shop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]},
  "event": [{"listen": "prerequest", "script": {"type": "text/javascript", "exec": ["pm.variables.set('t', Date.now())"]}}],
  "variable": [
    {"key": "base_url", "value": "https://api.example.com"},
    {"key": "api_secret", "value": "sk_live_123"},
    {"key": "old", "value": "x", "disabled": true}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{"listen": "test", "script": {"exec": ["pm.environment.set('token', pm.response.json().token)"]}}],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"nonce\": \"{{$guid}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/v1/login", "host": ["{{base_url}}"], "path": ["v1", "login"]}
          },
          "response": [
            {
              "name": "OK",
              "originalRequest": {"method": "POST", "url": "{{base_url}}/v1/login"},
              "status": "OK", "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\"token\": \"eyJ.live.token\", \"expires_in\": 3600}"
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "X-Old", "value": "1", "disabled": true}],
            "url": {
              "raw": "{{base_url}}/v1/users/:id?include=roles&debug=1",
              "host": ["{{base_url}}"], "path": ["v1", "users", ":id"],
              "query": [{"key": "include", "value": "roles"}, {"key": "debug", "value": "1", "disabled": true}],
              "variable": [{"key": "id", "value": "42"}]
            }
          }
        },
        {
          "name": "Get user orders",
          "request": {"method": "GET", "url": "{{base_url}}/v1/users/:user_id/orders"}
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{"key": "X-Api-Key", "value": "ak_live_999"}],
            "body": {"mode": "formdata", "formdata": [
              {"key": "name", "value": "{{$randomFullName}}", "type": "text"},
              {"key": "email", "value": "{{$randomEmail}}", "type": "text"},
              {"key": "iban", "value": "{{$randomBankAccountIban}}", "type": "text"},
              {"key": "avatar", "type": "file", "src": "/Users/ada/avatar.png"}
            ]},
            "url": "{{base_url}}/v1/users"
          }
        },
        {
          "name": "Search users",
          "request": {
            "auth": {"type": "basic", "basic": [{"key": "username", "value": "admin"}, {"key": "password", "value": "hunter2"}]},
            "method": "POST",
            "body": {"mode": "urlencoded", "urlencoded": [{"key": "q", "value": "ada"}, {"key": "page", "value": "1", "disabled": true}]},
            "url": "{{base_url}}/v1/users/search"
          }
        },
        {
          "name": "Broken",
          "request": {"method": "GET"}
        }
      ]
    },
    {
      "name": "Graph",
      "request": {
        "auth": {"type": "apikey", "apikey": [{"key": "key", "value": "api_key"}, {"key": "value", "value": "{{api_secret}}"}, {"key": "in", "value": "query"}]},
        "method": "POST",
        "body": {"mode": "graphql", "graphql": {"query": "query { me { id } }", "variables": "{\"a\": 1}"}},
        "url": "{{base_url}}/graphql"
      }
    },
    {
      "name": "Partner",
      "request": {
        "auth": {"type": "oauth2", "oauth2": [{"key": "accessToken", "value": "abc"}]},
        "method": "GET",
        "url": "https://partner.example.com/v2/stock?sku={{sku}}"
      }
    },
    {"name": "Empty thing"}
  ]
}
