--- request Orders/List-orders
name: List orders
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/orders"
    query:
      status: open
      page: "1"
    headers:
      Accept: application/json
      X-Api-Key: "{{secret.x_api_key}}"
      Authorization: Bearer {{secret.api_token}}
--- request Orders/Admin/Create-order
name: Create order
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/orders"
    headers:
      Authorization: Basic {{toBase64("ada" + ":" + secret.password)}}
    body:
      json: "{\"password\":\"(redacted)\",\"sku\":\"abc\"}"
--- request Orders/Form-post
name: Form post
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/forms"
    body:
      form:
        a: "1"
        secret: "{{secret.secret}}"
--- request Orders/Token
name: Token
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/token"
    auth:
      type: oauth2
      grant: client_credentials
      token_url: "{{env.base_url}}/oauth/token"
      client_id: abc
      client_secret: "{{secret.client_secret}}"
      scope: read
      client_auth: basic
--- request Orders/Browser-sign-in
name: Browser sign-in
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/me"
    auth:
      type: oauth2
      grant: authorization_code
      authorization_url: "{{env.base_url}}/oauth/authorize"
      token_url: "{{env.base_url}}/oauth/token"
      client_id: abc
      client_secret: "{{secret.client_secret}}"
      scope: read
      pkce: "on"
--- request Orders/Tagged
name: Tagged
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/{% uuid 'v4' %}"
--- environment shop-api
name: shop-api
vars:
  api_token:
    secret: true
  base_url: https://shop.example.com
--- environment production
name: production
vars:
  api_token:
    secret: true
  base_url: https://prod.example.com
