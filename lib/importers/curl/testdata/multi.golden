    method: GET
    url: https://api.example.com/v1/things
    query:
      q: a b
    headers:
      Content-Type: application/json
      Accept: application/json
    body:
      json: "{\"a\":1}"
--- request curl/post-v1-upload
name: POST /v1/upload
versions:
  "1":
    method: POST
    url: https://api.example.com/v1/upload
