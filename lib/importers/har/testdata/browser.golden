--- request har/api.example.com/post-v1-login
name: POST /v1/login
versions:
  "1":
    method: POST
    url: https://api.example.com/v1/login
    headers:
      content-type: application/json
      x-client: web
    body:
      json: "{\"email\":\"ada@example.com\",\"password\":\"(redacted)\"}"
--- request har/api.example.com/get-v1-users-id
name: GET /v1/users/{id}
versions:
  "1":
    method: GET
    url: https://api.example.com/v1/users/{{id}}
    query:
      include: roles
    headers:
      authorization: "{{secret.authorization}}"
      accept: application/json
--- request har/api.example.com/put-v1-users-id-avatar
name: PUT /v1/users/{id}/avatar
versions:
  "1":
    method: PUT
    url: https://api.example.com/v1/users/{{id}}/avatar
    headers:
      content-type: multipart/form-data; boundary=x
    body:
      multipart:
        caption: me
        file:
          file: me.png
--- flow har/browser
name: browser
nodes:
  - id: post-login
    type: request
    request:
      path: har/api.example.com/post-v1-login
  - id: get-users
    type: request
    request:
      path: har/api.example.com/get-v1-users-id
    with:
      id: "{{nodes.post-login.body.user.id}}"
  - id: get-users-2
    type: request
    request:
      path: har/api.example.com/get-v1-users-id
    with:
      id: "7"
  - id: put-avatar
    type: request
    request:
      path: har/api.example.com/put-v1-users-id-avatar
    with:
      id: "{{nodes.post-login.body.user.id}}"
