--- request auth/login
name: Login
versions:
  "1":
    method: POST
    url: "{{env.baseUrl}}/v1/login"
    headers:
      x-client: bruno
      content-type: application/json
    body:
      json: |-
        {
          "email": "{{env.email}}",
          "password": "{{secret.password}}"
        }
    extract:
      token:
        from: body
        path: $.token
--- request graph
name: Me
versions:
  "1":
    method: POST
    url: "{{env.baseUrl}}/graphql"
    headers:
      x-client: bruno
      Authorization: Basic {{toBase64("admin" + ":" + secret.password)}}
      Content-Type: application/json
    body:
      json: "{\"query\":\"query { me { id } }\",\"variables\":{\"a\":1}}"
--- request users/create-user
name: Create user
versions:
  "1":
    method: POST
    url: "{{env.baseUrl}}/v1/users"
    headers:
      x-client: bruno
      accept: application/json
      X-Api-Key: "{{secret.x_api_key}}"
    body:
      multipart:
        name: "{{$full-name}}"
        avatar:
          file: /Users/ada/me.png
--- request users/get-user
name: Get user
versions:
  "1":
    method: GET
    url: "{{env.baseUrl}}/v1/users/42"
    query:
      include: roles
    headers:
      x-client: bruno
      accept: application/json
      Authorization: Bearer {{token}}
    extract:
      userName:
        from: body
        path: $.name
      etag:
        from: header
        header: etag
      seen:
        from: body
        path: $.items[0].id
    assert:
      - status == 200
      - response.body.name != nil
--- environment local
name: local
vars:
  baseUrl: http://localhost:8080
  email: qa@example.com
  password:
    secret: true
  token:
    secret: true
