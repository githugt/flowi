--- request Orders/List-orders
name: List orders
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/orders"
    query:
      status: open
      page: "1"
    headers:
      Accept: application/json
      X-Api-Key: "{{secret.x_api_key}}"
      Authorization: Bearer {{secret.token}}
    assert:
      - status == 200
      - response.headers["content-type"] == "application/json"
      - response.body.items.id > 0
--- request Orders/Admin/Create-order
name: Create order
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/orders"
    headers:
      Authorization: Basic {{toBase64("ada" + ":" + secret.password)}}
    body:
      json: "{\"password\":\"(redacted)\",\"sku\":\"abc\"}"
--- request Orders/Form
name: Form
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/forms"
    body:
      form:
        a: "1"
        secret: "{{secret.secret}}"
--- request Upload
name: Upload
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/up"
    body:
      multipart:
        note: hi
--- request Query
name: Query
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/graphql"
    body:
      json: "{\"query\":\"{ me { id } }\",\"variables\":{\"a\": 1}}"
--- request Token
name: Token
versions:
  "1":
    method: POST
    url: "{{env.base_url}}/token"
    auth:
      type: oauth2
      grant: client_credentials
      token_url: "{{env.base_url}}/oauth/token"
      client_id: abc
      client_secret: "{{secret.client_secret}}"
      scope: read
--- request Hawk
name: Hawk
versions:
  "1":
    method: GET
    url: "{{env.base_url}}/h"
