      "params": [{"name": "page", "value": "1", "isPath": false}, {"name": "status", "value": "open", "isPath": false}, {"name": "id", "value": "7", "isPath": true}],
      "auth": {"type": "bearer", "bearer": "{{token}}"},
      "tests": [
        {"type": "res-code", "custom": "", "action": "equal", "value": "200"},
        {"type": "res-header", "custom": "Content-Type", "action": "equal", "value": "application/json"},
        {"type": "json-query", "custom": "json.items.id", "action": ">", "value": "0"},
        {"type": "res-body", "custom": "", "action": "contains", "value": "ok"}
