    {"_id": "r7", "colId": "c1", "containerId": "", "name": "Hawk", "url": "{{base_url}}/h", "method": "GET", "sortNum": 70000, "auth": {"type": "hawk"}},
    {"_id": "r8", "colId": "c1", "containerId": "", "name": "Empty", "url": "", "method": "GET", "sortNum": 80000}
