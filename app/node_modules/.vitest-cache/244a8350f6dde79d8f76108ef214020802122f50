/** The badge for a mode, or null for the usual one (all hooks run). */
function hookBadge(mode) {
	switch (mode) {
		case "none": return {
			text: "No hooks",
			title: "The hooks before and after are skipped for the next send. Click to run them again."
		};
		case "skip-pre": return {
			text: "No pre-hooks",
			title: "The hooks before the request are skipped for the next send. Click to run them again."
		};
		case "skip-post": return {
			text: "No post-hooks",
			title: "The hooks after the response are skipped for the next send. Click to run them again."
		};
		default: return null;
	}
}

