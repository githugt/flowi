function verdictText(verdict, status) {
	const code = status ? `${status} ` : "";
	switch (verdict) {
		case "denied": return {
			mark: "✓",
			text: `${code}refused, as it should be`,
			title: "Another identity was refused: access is protected"
		};
		case "allowed": return {
			mark: "✗",
			text: `${code}let in: not protected`,
			title: "Another identity was let in: this resource is open to it"
		};
		default: return {
			mark: "?",
			text: `${code}unclear`,
			title: "The answer does not show whether access was refused"
		};
	}
}

