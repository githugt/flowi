/** What the wire will write: the template that reads the step's value (Go's readRef). */
function wireRef(from, take) {
	const path = take.trim();
	if (!from) return `{{inputs.${path}}}`;
	return `{{nodes.${from}${path ? "." + path : ""}}}`;
};
/** The line under "Take": what the path gives in the step's last run, or why there is nothing to show. */
function previewLine(p) {
	if (!p) return {
		kind: "none",
		text: ""
	};
	if (!p.ran) return {
		kind: "norun",
		text: "Run the flow to see the value this would pass."
	};
	if (!p.found) return {
		kind: "missing",
		text: "Nothing at this path in the last run."
	};
	return {
		kind: "value",
		text: p.text === "" ? "(empty text)" : p.text
	};
}

