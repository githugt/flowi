function headersHint(kind) {
	switch (kind) {
		case "send": return "Headers travel with each message sent.";
		case "connect": return "Sent when the connection opens. Put the credential here, for example Authorization: Bearer {{secret.token}}.";
		default: return "Content-Type, Accept and the like. Credentials go in Auth.";
	}
}

