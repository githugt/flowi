/** The shortcuts shown when no tab is open. */
function watermarkHints(mac) {
	const mod = mac ? "⌘" : "Ctrl+";
	const shift = mac ? "⇧" : "Shift+";
	return [
		{
			label: "New request",
			keys: `${mod}N`
		},
		{
			label: "Jump to a request or flow",
			keys: `${mod}K`
		},
		{
			label: "Command palette",
			keys: `${mod}${shift}P`
		},
		{
			label: "Import an API",
			keys: `${mod}I`
		}
	];
}

