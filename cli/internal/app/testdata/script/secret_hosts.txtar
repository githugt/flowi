# Hosts that may receive secrets: listed, added one at a time, removed.
# Before: a collection could send a secret to any host, and there was no list to allow one on.
exec flowi workspace mount ./example

exec flowi secret hosts
! stdout .
stderr 'No hosts allowed'

exec flowi secret allow-host API.Example.com
stderr 'Secrets may now be sent to api.example.com'
exec flowi secret allow-host https://tools.example.org:8443/v1
exec flowi secret allow-host api.example.com
exec flowi secret hosts
stdout '^api.example.com$'
stdout '^tools.example.org:8443$'

# The list is the person's own setting.
exec flowi config get secrets.allowed_hosts
stdout 'api.example.com'

# Not a host, and a bare wildcard: refused as bad input.
! exec flowi secret allow-host '*'
stderr 'every host'
! exec flowi secret allow-host 'two words'
stderr 'not a host'

exec flowi secret deny-host api.example.com
stderr 'no longer sent to api.example.com'
! exec flowi secret deny-host api.example.com
stderr 'not on the list'
exec flowi secret hosts
! stdout 'api.example.com$'
stdout 'tools.example.org:8443'
